# ---------------------------------------------------------------------------
# Watchy — MongoDB backup scheduler
# Copy this file to .env and adapt.
# ---------------------------------------------------------------------------

# --- App authentication -----------------------------------------------------
# Username used to log in via the web UI.
APP_USERNAME=admin
# Argon2 hash of the password. Generate with: npm run hash-password
# NEVER put the plaintext password here.
APP_PASSWORD_HASH=

# 32+ byte random string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# --- Default MongoDB connection --------------------------------------------
# All backup targets share this connection unless they define a customUri.
MONGO_HOST=127.0.0.1
MONGO_PORT=27017
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin
# Extra querystring options, e.g. "replicaSet=rs0&tls=true"
MONGO_EXTRA_OPTIONS=

# --- Scheduling & retention -------------------------------------------------
# Cron expression (5 fields, node-cron). Default: every day at 03:00.
BACKUP_CRON=0 3 * * *
# Days to keep non-protected backups. Monthly backups are auto-protected.
BACKUP_RETENTION_DAYS=90
# Timezone used for cron and timestamps.
TZ=Europe/Paris

# --- Storage paths (inside the container) -----------------------------------
# App data (targets + history JSON files). Mounted as a small volume.
DATA_DIR=/app/data
# Backup destination. MUST be a bind mount to the USB stick on the host.
BACKUP_DIR=/app/backups

# --- SMTP notifications (optional) ------------------------------------------
# Leave SMTP_HOST empty to disable email notifications entirely.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# --- HTTP ------------------------------------------------------------------
PORT=3000
